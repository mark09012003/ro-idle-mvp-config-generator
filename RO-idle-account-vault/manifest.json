{
  "manifest_version": 3,
  "name": "RO放置仙境 帳號櫃",
  "short_name": "帳號櫃",
  "version": "1.10.70",
  "description": "保存帳密，切換時清除遊戲 Cookie 並填入帳密及點擊登入；角色由使用者自行選擇。",
  "permissions": [
    "cookies",
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ro-idle.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "開啟帳號櫃",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ro-idle.app/*"
      ],
      "js": [
        "logs-model.js",
        "logs-capture.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ro-idle.app/*"
      ],
      "js": [
        "presence.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ro-idle.app/*"
      ],
      "js": [
        "logs-stream.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
